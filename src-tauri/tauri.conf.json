{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BICARA",
  "version": "0.1.1",
  "identifier": "id.bicara.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BICARA",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      },
      {
        "label": "overlay",
        "title": "BICARA Overlay",
        "url": "index.html?view=overlay",
        "width": 420,
        "height": 360,
        "alwaysOnTop": true,
        "resizable": true,
        "x": 40,
        "y": 60
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2"
    },
    "category": "Productivity"
  }
}